<Project Sdk="Microsoft.NET.Sdk">

  <!-- Koikatsu has nearly the same maker as Koikatsu Sunshine, so it uses the KKS folder's game code -->
  <PropertyGroup>
    <!-- Koikatsu runs on the older .NET 3.5 runtime -->
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>KK_AdvancedLoader</AssemblyName>
    <DefineConstants>$(DefineConstants);KK</DefineConstants>
    <GamePath Condition="'$(GamePath)' == ''">$(KKGamePath)</GamePath>
    <!-- Built against the oldest Modding API it works with, which is older than the one Material Editor 4 is built against -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\KKS\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IllusionLibs.Koikatu.AllPackages" Version="2019.4.27.4" />
    <PackageReference Include="IllusionModdingAPI.KKAPI" Version="1.42.2" />
    <PackageReference Include="ExtensibleSaveFormat.Koikatu" Version="21.1.3" />
    <!-- Soft dependencies: only the *Bridge classes touch these types, and only when those plugins are loaded -->
    <PackageReference Include="OverlayMods.Koikatu" Version="6.2.0" />
    <PackageReference Include="ABMX.KKABMX" Version="5.4.0" />
    <PackageReference Include="MaterialEditor.Koikatu" Version="4.0.3" />
  </ItemGroup>

</Project>
