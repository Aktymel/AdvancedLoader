<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>HS2_AdvancedLoader</AssemblyName>
    <DefineConstants>$(DefineConstants);HS2</DefineConstants>
    <GamePath Condition="'$(GamePath)' == ''">$(HS2GamePath)</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IllusionLibs.HoneySelect2.AllPackages" Version="2020.5.29.5" />
    <PackageReference Include="IllusionModdingAPI.HS2API" Version="1.48.0" />
    <PackageReference Include="ExtensibleSaveFormat.HoneySelect2" Version="21.1.3" />
    <!-- Soft dependencies: only the *Bridge classes touch these types, and only when those plugins are loaded -->
    <PackageReference Include="OverlayMods.HoneySelect2" Version="6.3.0" />
    <PackageReference Include="ABMX.HS2ABMX" Version="5.2.2" />
    <PackageReference Include="MaterialEditor.HoneySelect2" Version="4.0.3" />
  </ItemGroup>

</Project>
