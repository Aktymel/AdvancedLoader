<Project Sdk="Microsoft.NET.Sdk">

  <!-- AI-Shoujo has the same maker as Honey Select 2, so it uses the HS2 folder's game code -->
  <PropertyGroup>
    <AssemblyName>AI_AdvancedLoader</AssemblyName>
    <DefineConstants>$(DefineConstants);AI</DefineConstants>
    <GamePath Condition="'$(GamePath)' == ''">$(AIGamePath)</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\HS2\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IllusionLibs.AIGirl.AllPackages" Version="2020.5.29.5" />
    <PackageReference Include="IllusionModdingAPI.AIAPI" Version="1.48.0" />
    <PackageReference Include="ExtensibleSaveFormat.AIGirl" Version="21.1.3" />
    <!-- Soft dependencies: only the *Bridge classes touch these types, and only when those plugins are loaded -->
    <PackageReference Include="OverlayMods.AIGirl" Version="6.3.0" />
    <PackageReference Include="ABMX.AIABMX" Version="5.2.2" />
    <PackageReference Include="MaterialEditor.AIGirl" Version="4.0.3" />
  </ItemGroup>

</Project>
